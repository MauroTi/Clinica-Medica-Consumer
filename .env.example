# Configuração da Aplicação Clinica Consumer
# Copie este arquivo para .env e ajuste conforme necessário

# Porta do servidor
PORT=3001

# Ambiente (development, production, test)
NODE_ENV=development

# URL da API Clinica Médica (backend original)
CLINICA_API_URL=http://localhost:3000

# Timeout para requisições (em milissegundos)
API_REQUEST_TIMEOUT=5000

# Número de tentativas de retry
API_RETRY_ATTEMPTS=3

# Delay inicial para retry em milissegundos (usa backoff exponencial)
API_RETRY_DELAY=1000
